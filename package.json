{
  "name": "vercel-armor-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for vercel-armor library + demo/landing web app.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=vercel-armor",
    "test": "npm run test --workspace=vercel-armor",
    "dev": "npm run dev --workspace=web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
